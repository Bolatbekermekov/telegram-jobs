# Copy to `Makefile` and put your own @username in TO. The real Makefile is gitignored
# (keeps your handle out of the public repo). Run from sender/ with the venv active.
#
#   make dry   -> generate a message for a lead and just print it (no Telegram)
#   make test  -> send a TEST message to yourself (TO below); lead status is NOT changed
#   make run   -> real interactive run (run.py): approve / edit / send per lead

PYTHON ?= python
TO ?= @your_username

.PHONY: dry test run

dry:
	$(PYTHON) test_send.py --dry-run

test:
	$(PYTHON) test_send.py --to "$(TO)"

run:
	$(PYTHON) run.py
