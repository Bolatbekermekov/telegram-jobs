# Secrets — NEVER commit
.env
*.env
service_account.json
*.session
*.session-journal
# Playwright login sessions (LinkedIn/Wellfound cookies = account access)
*_state.json
# Real-Chrome profile used for the interactive Wellfound session (login cookies)
sender/.wellfound_chrome/
cv.pdf
# CV lives in sender/cv/ but must never be committed (public repo). Keep the folder, ignore its files.
sender/cv/*
!sender/cv/.gitkeep
# Personal contacts block (has email/phone/LinkedIn). Keep the .example, ignore the real one.
sender/signature.txt
# Personal apply-form answers (phone, salary, visa, custom answers). Keep the .example, ignore the real one.
sender/apply_profile.yml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.python-version

# Vercel
.vercel/

# OS
.DS_Store
Thumbs.db

# Real-Chrome profile used for the interactive hh.ru login (login cookies)
sender/.hh_chrome/

# Playwright MCP browser profile (session data / artifacts, not source)
.playwright-mcp/
