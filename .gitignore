# Secrets — NEVER commit
.env
*.env
service_account.json
*.session
*.session-journal
# Playwright login sessions (LinkedIn/Wellfound cookies = account access)
# Хвост после .json тоже: протухшую сессию принято отодвигать в сторону под
# именем hh_state.json.dead-<дата>, и такой файл под `*_state.json` не подходил —
# 18 КБ живых кук лежали неигнорируемыми и ждали случайного `git add -A`.
*_state.json
*_state.json.*
# Real-Chrome profile used for the interactive Wellfound session (login cookies)
sender/.wellfound_chrome/
cv.pdf
# CV lives in sender/cv/ but must never be committed (public repo). Keep the folder, ignore its files.
sender/cv/*
!sender/cv/.gitkeep
# Personal contacts block (has email/phone/LinkedIn). Keep the .example, ignore the real one.
sender/signature.txt
# Personal apply-form answers (phone, salary, visa, custom answers). Keep the .example, ignore the real one.
sender/apply_profile.yml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.python-version

# Vercel
.vercel/

# OS
.DS_Store
Thumbs.db

# Real-Chrome profile used for the interactive hh.ru login (login cookies)
sender/.hh_chrome/

# Same, for the interactive RemoteOK login
sender/.remoteok_chrome/

# DOM dumps + screenshots written when an hh selector breaks. A logged-in page's
# HTML carries the CSRF token, the full name and resume data — never commit it.
sender/.hh_chat_debug/

# Локальный кэш вакансий, отвергнутых скорером (не источник истины)
sender/.scored_out.json

# Playwright MCP browser profile (session data / artifacts, not source)
.playwright-mcp/

# VS Code (личные настройки, не в публичный репо)
.vscode/

# subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/
