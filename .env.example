# ============================================================================
#  telegram-jobs — пример переменных окружения.
#  Скопируй этот файл в `.env` (в корне проекта) и подставь свои значения.
#  Файл `.env` в .gitignore и НИКОГДА не коммитится — в нём реальные секреты.
#  Один общий .env используют оба компонента: intake-bot и sender.
# ============================================================================

# ---- OpenAI ----
# Ключ API OpenAI. Нужен и боту (вытащить контакт + сжать вакансию),
# и sender'у (сгенерировать персональное сообщение по CV).
# Взять: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxx
# Модель для текстов, которые читает человек: письмо HR и ответы на вопросы hh.
OPENAI_MODEL=gpt-5.4-mini
# Модель для массовых служебных вызовов: оценка релевантности каждой найденной
# вакансии и краткое саммари в боте-приёмнике. Их в разы больше, чем писем,
# поэтому здесь берём самый дешёвый тир — это основная статья расходов.
OPENAI_MODEL_CHEAP=gpt-5.4-nano
# Потолок длины ответа модели. Текст вакансии приходит с чужого сайта, так что
# без лимита внедрённое «напиши 10000 слов» будет оплачено полностью.
OPENAI_MAX_OUTPUT_TOKENS=2000

# ---- Telegram bot (intake) ----
# Токен бота-приёмника от @BotFather. Им бот принимает вакансии с телефона
# и отвечает (✅ Сохранил лид / /status). Используется ТОЛЬКО облачным intake-bot.
TELEGRAM_BOT_TOKEN=123456:xxxxxxxx

# ---- Telegram userbot (sender) ----
# Данные ТВОЕГО личного аккаунта с https://my.telegram.org (API development tools).
# Нужны Telethon'у, чтобы рассылать DM «от твоего имени». Только для локального sender.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Google Sheets ----
# Таблица — единое хранилище лидов (бот пишет, sender читает/обновляет статусы).
#
# ЛОКАЛЬНО (sender и локальный запуск бота): путь к JSON-ключу сервис-аккаунта.
# Относительный путь считается от корня проекта. Файл тоже в .gitignore.
# Получить: Google Cloud Console → сервис-аккаунт → ключ → скачать JSON →
# положить как ./service_account.json.
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json
#
# ОБЛАКО (Vercel, публичный репо): файл туда не попадает (он в .gitignore),
# поэтому на хосте вставь СЮДА всё СОДЕРЖИМОЕ service_account.json одной строкой/блоком.
# Локально оставляй пустым. Если задано — имеет приоритет над файлом выше.
GOOGLE_SERVICE_ACCOUNT_JSON=
#
# ID таблицы — часть URL между /d/ и /edit.
SHEET_ID=1E8W0w7uIEU09sp2swth_nZebC4il2p1Zeq6Sr3J70pk
# Имя листа (вкладки) внизу таблицы. По умолчанию у Google — «Лист1».
SHEET_TAB=Лист1
# ВАЖНО: расшарь таблицу на e-mail сервис-аккаунта (client_email из JSON)
# с правом «Редактор», иначе бот/sender получат ошибку доступа 403.

# ---- CV ----
# По умолчанию sender берёт резюме из папки sender/cv/ (положи туда один PDF или txt).
# Эта переменная — необязательный override: укажи полный путь, если CV лежит в другом
# месте; если файл по пути есть — он имеет приоритет над папкой. Пусто = берём из sender/cv/.
# CV в публичный репо не кладём (папка под .gitignore, кроме .gitkeep).
CV_PATH=

# ---- Sender safety (анти-бан для userbot) ----
# Рассылка с личного аккаунта нарушает ToS Telegram → риск блокировки.
# Эти лимиты снижают риск; не задирай их.
# Случайная пауза между отправками: от MIN до MAX секунд.
# Сколько ждать кнопку «Отправить» в попапе отклика на hh. Срабатывает только
# когда отклик ещё НЕ ушёл (быстрый отклик распознаётся раньше), поэтому большое
# значение ничего не тормозит на обычном пути — просто даёт медленному попапу
# прогрузиться. Уменьши, если хочешь, чтобы непонятная вёрстка падала быстрее.
HH_SUBMIT_TIMEOUT_SECONDS=100

MIN_DELAY_SECONDS=40
MAX_DELAY_SECONDS=120
# Прикладывать ли PDF-резюме к сообщению (true/false).
ATTACH_CV=true
# Авто-отправка. false (по умолчанию) = спрашивает send/edit/skip по каждому лиду.
# true = отправляет всё сам, без подтверждения, с теми же паузами и логами.
# ВНИМАНИЕ: в авто-режиме ты не вычитываешь сообщения перед отправкой, риск выше.
AUTO_SEND=false

# --- LinkedIn / Wellfound (browser automation; ToS risk accepted) ---
LINKEDIN_STATE_PATH=sender/linkedin_state.json
WELLFOUND_STATE_PATH=sender/wellfound_state.json
# Путь к сохранённой сессии hh.ru (patchright). Не задано = sender/hh_state.json по умолчанию.
# HH_STATE_PATH=
# Логин hh.ru идёт через твой настоящий Chrome (см. make login_hh); порт/профиль можно поменять.
# HH_CDP_PORT=9223
# HH_CHROME_PROFILE=sender/.hh_chrome
BROWSER_HEADLESS=false

# --- Email (SMTP, e.g. Gmail app password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=
