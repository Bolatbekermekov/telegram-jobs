# ============================================================================
#  telegram-jobs — пример переменных окружения.
#  Скопируй этот файл в `.env` (в корне проекта) и подставь свои значения.
#  Файл `.env` в .gitignore и НИКОГДА не коммитится — в нём реальные секреты.
#  Один общий .env используют оба компонента: intake-bot и sender.
# ============================================================================

# ---- OpenAI ----
# Ключ API OpenAI. Нужен и боту (вытащить контакт + сжать вакансию),
# и sender'у (сгенерировать персональное сообщение по CV).
# Взять: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxx
# Модель для текстов, которые читает человек: письмо HR и ответы на вопросы hh.
OPENAI_MODEL=gpt-5.4-mini
# Модель для массовых служебных вызовов: оценка релевантности каждой найденной
# вакансии и краткое саммари в боте-приёмнике. Их в разы больше, чем писем,
# поэтому здесь берём самый дешёвый тир — это основная статья расходов.
OPENAI_MODEL_CHEAP=gpt-5.4-nano
# Потолок длины ответа модели. Текст вакансии приходит с чужого сайта, так что
# без лимита внедрённое «напиши 10000 слов» будет оплачено полностью.
OPENAI_MAX_OUTPUT_TOKENS=2000

# ---- Telegram bot (intake) ----
# Токен бота-приёмника от @BotFather. Им бот принимает вакансии с телефона
# и отвечает (✅ Сохранил лид / /status). Используется ТОЛЬКО облачным intake-bot.
TELEGRAM_BOT_TOKEN=123456:xxxxxxxx

# ---- Telegram userbot (sender) ----
# Данные ТВОЕГО личного аккаунта с https://my.telegram.org (API development tools).
# Нужны Telethon'у, чтобы рассылать DM «от твоего имени». Только для локального sender.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Google Sheets ----
# Таблица — единое хранилище лидов (бот пишет, sender читает/обновляет статусы).
#
# ЛОКАЛЬНО (sender и локальный запуск бота): путь к JSON-ключу сервис-аккаунта.
# Относительный путь считается от корня проекта. Файл тоже в .gitignore.
# Получить: Google Cloud Console → сервис-аккаунт → ключ → скачать JSON →
# положить как ./service_account.json.
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json
#
# ОБЛАКО (Vercel, публичный репо): файл туда не попадает (он в .gitignore),
# поэтому на хосте вставь СЮДА всё СОДЕРЖИМОЕ service_account.json одной строкой/блоком.
# Локально оставляй пустым. Если задано — имеет приоритет над файлом выше.
GOOGLE_SERVICE_ACCOUNT_JSON=
#
# ID таблицы — часть URL между /d/ и /edit.
SHEET_ID=1E8W0w7uIEU09sp2swth_nZebC4il2p1Zeq6Sr3J70pk
# Имя листа (вкладки) внизу таблицы. По умолчанию у Google — «Лист1».
SHEET_TAB=Лист1
# ВАЖНО: расшарь таблицу на e-mail сервис-аккаунта (client_email из JSON)
# с правом «Редактор», иначе бот/sender получат ошибку доступа 403.

# ---- CV ----
# По умолчанию sender берёт резюме из папки sender/cv/ (положи туда один PDF или txt).
# Эта переменная — необязательный override: укажи полный путь, если CV лежит в другом
# месте; если файл по пути есть — он имеет приоритет над папкой. Пусто = берём из sender/cv/.
# CV в публичный репо не кладём (папка под .gitignore, кроме .gitkeep).
CV_PATH=

# ---- Sender safety (анти-бан для userbot) ----
# Рассылка с личного аккаунта нарушает ToS Telegram → риск блокировки.
# Эти лимиты снижают риск; не задирай их.
# Случайная пауза между отправками: от MIN до MAX секунд.
# Сколько ждать кнопку «Отправить» в попапе отклика на hh. Срабатывает только
# когда отклик ещё НЕ ушёл (быстрый отклик распознаётся раньше), поэтому большое
# значение ничего не тормозит на обычном пути — просто даёт медленному попапу
# прогрузиться. Уменьши, если хочешь, чтобы непонятная вёрстка падала быстрее.
HH_SUBMIT_TIMEOUT_SECONDS=100

MIN_DELAY_SECONDS=40
MAX_DELAY_SECONDS=120
# Прикладывать ли PDF-резюме к сообщению (true/false).
ATTACH_CV=true
# Авто-отправка. false (по умолчанию) = спрашивает send/edit/skip по каждому лиду.
# true = отправляет всё сам, без подтверждения, с теми же паузами и логами.
# ВНИМАНИЕ: в авто-режиме ты не вычитываешь сообщения перед отправкой, риск выше.
AUTO_SEND=false

# Площадки, которые НЕ трогают ни отправка, ни поиск: пусто, "linkedin" или
# "linkedin,hh". Лиды такой площадки остаются `new` и ждут снятия паузы — они не
# становятся `skipped`, иначе прогон больше никогда бы их не поднял. Нужно, когда
# аккаунт площадки под ограничением: проверка приглашённых открывает LinkedIn
# первым делом в каждом прогоне, и без паузы нельзя отправить даже то, что к нему
# отношения не имеет.
# Поиск (`make search`, авто-поиск воркера, команды из вкладки «Команды») такую
# площадку не поднимает вовсе. Воркер читает это значение при старте — после
# правки его надо перезапустить.
PAUSED_PLATFORMS=

# --- LinkedIn / Wellfound (browser automation; ToS risk accepted) ---
LINKEDIN_STATE_PATH=sender/linkedin_state.json
WELLFOUND_STATE_PATH=sender/wellfound_state.json
# Путь к сохранённой сессии hh.ru (patchright). Не задано = sender/hh_state.json по умолчанию.
# HH_STATE_PATH=
# Логин hh.ru идёт через твой настоящий Chrome (см. make login_hh); порт/профиль можно поменять.
# HH_CDP_PORT=9223
# HH_CHROME_PROFILE=sender/.hh_chrome
BROWSER_HEADLESS=false

# --- Чем hh отбирает вакансии ---
# До 2026-08-27 hh не фильтровал НИЧЕМ: запрос уходил голым текстом. Замер того
# дня — 30 лидов, почти все Москва и Санкт-Петербург, при том что владелец
# аккаунта живёт в Астане и ищет удалённую работу. Значения ниже сняты с живой
# выдачи: фильтры ставились руками в интерфейсе, адрес читался после применения.
# Одноимённые параметры hh складывает по ИЛИ, разные — по И.
#
# Формат работы: REMOTE (удалённо), HYBRID (гибрид), ON_SITE (в офисе),
# FIELD_WORK (разъездная); можно несколько через запятую, пусто = любой.
# Замер по 14 словам из SEARCH_KEYWORDS: без фильтра 16 134 вакансии,
# с удалёнкой 6 005 — то есть больше трети выдачи, и минимум 68 вакансий на
# самом узком слове при потолке 25 на слово. Заметь: «Москвы» в колонке адреса
# от этого не убавится (удалёнку чаще всего публикуют московские компании) —
# но такую вакансию из Астаны можно реально подать, а офис в Москве нельзя.
HH_WORK_FORMAT=REMOTE
# Регион — ЧИСЛОВОЙ id hh (общий SEARCH_LOCATION вида «Worldwide» hh не
# понимает). 1=Москва, 2=Санкт-Петербург, 40=Казахстан, 113=Россия, 159=Астана,
# 160=Алматы, 16=Беларусь, 97=Узбекистан, 1001=Другие регионы; можно несколько
# через запятую. Пусто = без фильтра региона, и это НЕ забывчивость: регион hh
# складывает с форматом работы по И, а «Казахстан + удалённо» даёт 3–56 вакансий
# на слово — на 8 словах из 14 меньше потолка в 25, то есть выдача упирается в
# дно. Поставь 159, если нужен только свой город (тогда стоит очистить и
# HH_WORK_FORMAT — иначе останется удалёнка внутри Астаны, это единицы вакансий).
HH_AREAS=
# Требуемый работодателем опыт: noExperience, between1And3, between3And6,
# moreThan6; несколько через запятую, пусто = любой. Пусто по умолчанию, хотя
# ищется junior/middle: «удалёнка + нет опыта + 1–3 года» оставляет 1 820
# вакансий из 6 005, а вакансию «от 3 лет», куда junior всё-таки проходит,
# жёсткий фильтр потерял бы навсегда. Уровень и так отсеивает ИИ-скоринг
# (sender/search_profile.txt: «НЕ senior/lead/staff»).
HH_EXPERIENCE=
# Окно публикации в ДНЯХ: 1, 3, 7, 30; 0 = за всё время. То же правило, что у
# LinkedIn (LINKEDIN_POSTED_WITHIN=r604800). Глубже месяца hh не хранит вовсе:
# замер «python developer» — за всё время 5 236, за месяц 5 236, за неделю
# 1 913, за сутки 467. Поставь 0, если очередь лидов пересыхает: на самых узких
# словах («next.js developer») неделя оставляет 23 вакансии при потолке 25.
HH_SEARCH_PERIOD=7
# Сортировка: пусто = по релевантности (как у самого hh), publication_time = по
# дате, salary_desc / salary_asc — по зарплате. Оставлено по релевантности:
# потолок в 25 карточек на слово должен доставаться лучшим совпадениям, а за
# свежесть отвечает HH_SEARCH_PERIOD выше.
HH_ORDER_BY=
# Сколько страниц выдачи проходить по каждому слову (на странице 50 карточек).
HH_PAGES=2

# --- Remocate ---
# Агрегатор чужих вакансий. Ни аккаунта, ни браузера не нужно: и лента, и
# страница вакансии публичные, а отклик всё равно живёт на сайте работодателя
# (площадка `remocate` в таблице — это он).
#
# Сколько страниц ленты раздела проходить (по 20 вакансий; всего в разделе 102).
# Три — это граница ЖИВОГО запаса, а не круглое число. Замер 2026-08-27,
# случайные выборки живьём:
#   * sitemap (5049 ссылок) брать НЕЛЬЗЯ — 65% вакансий там мертвы, до отправки
#     дошла бы одна из сорока (2,5%);
#   * лента раздела: доля мёртвых по страницам 1-я — 15%, 3-я — 25%,
#     10-я — 75%, 30-я — 60%, 70-я — 70%. Обрыв между третьей и десятой.
# То есть живого около 60 вакансий: remocate — не «две тысячи вакансий», а
# быстрая узкая лента, которую надо опрашивать часто и неглубоко. Ставь больше,
# только если очередь лидов пересыхает, и помни, что каждая страница за третьей
# приносит в основном мёртвые ссылки. Ноль или пусто = вернуться к трём.
REMOCATE_PAGES=3

# --- Threads (Meta) ---
# Путь к сохранённой сессии Threads. Нужен ТОЛЬКО запасному варианту — DM автору
# поста, когда в треде вообще нет контакта. Чтение треда (основной путь: найти в
# нём телеграм/почту рекрутёра) идёт АНОНИМНО, без сессии, и этой переменной не
# требует. Не задано = sender/threads_state.json по умолчанию.
#
# ВНИМАНИЕ: Threads работает на аккаунте Instagram, поэтому автоматизация рискует
# ИМЕННО ИМ. Используй ОТДЕЛЬНЫЙ (burner) Instagram, не свой основной: отключённый
# Instagram автоматически отключает и его профиль Threads.
# Вход один раз: make login_threads
THREADS_STATE_PATH=sender/threads_state.json

# --- Email (SMTP, e.g. Gmail app password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=
